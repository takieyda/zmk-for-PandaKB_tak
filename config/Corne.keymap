#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#define LWRCLR RGB_COLOR_HSB_VAL(80,70,50)   // #648026
#define RSECLR RGB_COLOR_HSB_VAL(180,70,50)  // #268080
#define NAVCLR RGB_COLOR_HSB_VAL(220,60,40)  // #293D66
#define ADJCLR RGB_COLOR_HSB_VAL(360,80,40)  // #661414

// dt-formatter: indent = "    "
// dt-formatter: multilineIntegerCellsIndent = "reindent"
// dt-formatter: multilineListCommaStyle = "leading"

// Sticky modifiers must be released before another sticky modifier can be chained.
&sk {
    /delete-property/ ignore-modifiers;
};

/ {
    combos {
        compatible = "zmk,combos";

        // W+E sends Tab.
        tab {
            key-positions = <2 3>;
            bindings = <&kp TAB>;
        };

        // X+C sends Left Ctrl.
        ctrl {
            key-positions = <26 27>;
            bindings = <&kp LCTRL>;
        };

        // Left inner thumb pair sends Left GUI.
        cmd {
            key-positions = <37 38>;
            bindings = <&kp LGUI>;
        };

        // Right inner thumb pair sends Left Alt.
        alt {
            key-positions = <39 40>;
            bindings = <&kp LEFT_ALT>;
        };

        // I+O sends Left Shift.
        shift {
            key-positions = <8 9>;
            bindings = <&kp LSHIFT>;
        };

        // G+H enables Caps Word.
        // Capitalizes the next word typed, then disables itself.
        caps_word {
            key-positions = <17 18>;
            bindings = <&caps_word>;
        };

        // Comma+Period sends Delete.
        delete {
            key-positions = <32 33>;
            bindings = <&kp DEL>;
        };
    };

    macros {
        // Hold the requested layer, set its requested RGB color, then toggle underglow on release.
        rgblayer: rgb_layer {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            label = "MOMENTARY_LAYER_WITH_RGB_COLOR";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                // Macro argument 2 sent to next macro binding's first parameter
                // Ex. &rgblayer LWRCLR 2, Layer value 2 sent to next binding first parameter
                = <&macro_param_2to1>
                // Macro presses/holds $mo [layer], &mo 2
                , <&macro_press &mo MACRO_PLACEHOLDER>
                // Macro argument 1 sent to next macro binding's first parameter
                , <&macro_param_1to2>
                // Macro taps underglow, first param is RGB_COLOR_HSB_CMD,
                //second param is the color value from the keymap binding, variable LWRCLR
                , <&macro_tap &rgb_ug RGB_COLOR_HSB_CMD MACRO_PLACEHOLDER>
                // Macro pauses until the key is released, holding layer (not &rgb_ug)
                , <&macro_pause_for_release>
                // Macro argument 1 sent to next macro binding's first parameter
                , <&macro_param_2to1>
                // Macro releases the layer
                , <&macro_release &mo MACRO_PLACEHOLDER>
                // Macro taps underglow toggling it off
                , <&macro_tap &rgb_ug RGB_TOG>
                ;
        };

        // Hold layer 2 and set the keymap-supplied RGB color; toggle underglow on release.
        lower_rgb: lower_rgb {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "LOWER_LAYER_WITH_RGB";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_param_1to2>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB_CMD MACRO_PLACEHOLDER>
                , <&macro_press &mo 2>
                , <&macro_pause_for_release>
                , <&macro_release &mo 2>
                , <&macro_tap &rgb_ug RGB_TOG>
                ;
        };

        // Hold layer 3 and set the keymap-supplied RGB color; toggle underglow on release.
        raise_rgb: raise_rgb {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "RAISE_LAYER_WITH_RGB";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_param_1to2>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB_CMD MACRO_PLACEHOLDER>
                , <&macro_press &mo 3>
                , <&macro_pause_for_release>
                , <&macro_release &mo 3>
                , <&macro_tap &rgb_ug RGB_TOG>
                ;
        };

        // Hold layer 5 and set the keymap-supplied RGB color; toggle underglow on release.
        nav_rgb: nav_rgb {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "NAV_LAYER_WITH_RGB";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_param_1to2>
                , <&macro_tap &rgb_ug RGB_COLOR_HSB_CMD MACRO_PLACEHOLDER>
                , <&macro_press &mo 5>
                , <&macro_pause_for_release>
                , <&macro_release &mo 5>
                , <&macro_tap &rgb_ug RGB_TOG>
                ;
        };

        // Apply Left Shift to the key passed to this macro.
        shift: with_lshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "KEY_PRESS_WITH_LEFT_SHIFT_MODIFIER";
            bindings
                = <&macro_press>
                , <&kp LSHFT>
                , <&macro_tap>
                , <&macro_param_1to1 &kp MACRO_PLACEHOLDER>
                , <&macro_release>
                , <&kp LSHFT>
                ;
        };

        // &as binding, Behavior chain $as -> $as_ht -> $shift
        // Run the autoshift hold-tap for the passed key until it is released.
        as: autoshift {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            label = "AUTOSHIFT_KEYPRESS";
            bindings
                = <&macro_press>
                , <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_release>
                , <&macro_param_1to1 &macro_param_1to2 &as_ht MACRO_PLACEHOLDER MACRO_PLACEHOLDER>
                ;
        };
    };

    behaviors {
        // Tap sends the key; holding past the tapping term applies Shift.
        as_ht: autoshift_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            label = "AUTOSHIFT_HOLD_TAP";
            bindings = <&shift>, <&kp>;

            tapping-term-ms = <190>;
        };

        // Hold runs the layer/color macro; tap sends the key specified at the keymap binding.
        // Example: &lrgbt RGB_COLOR_HSB_VAL(240,100,100) SPACE
        lrgbt: lower_rgb_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            label = "LOWER_LAYER_OR_TAP";
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&lower_rgb>, <&kp>;
        };

        // Hold Raise with the requested color; tap sends the key supplied at the keymap binding.
        rrgbt: raise_rgb_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            label = "RAISE_LAYER_OR_TAP";
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&raise_rgb>, <&kp>;
        };

        // Hold Nav with the requested color; tap sends the key supplied at the keymap binding.
        nrgbt: nav_rgb_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            label = "NAV_LAYER_OR_TAP";
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&nav_rgb>, <&kp>;
        };

        // Hold with the modifier; tap the key. Opposite-hand presses can trigger the hold early.
        hml: homewrow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            label = "HOMEROW_MODS_LEFT_HAND";
            bindings = <&kp>, <&kp>;
            tapping-term-ms = <200>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
        };

        // Hold with the modifier; tap the key. Opposite-hand presses can trigger the hold early.
        hmr: homewrow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            label = "HOMEROW_MODS_RIGHT_HAND";
            bindings = <&kp>, <&kp>;
            tapping-term-ms = <200>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        // One tap applies sticky Shift; a double tap sends Caps Lock.
        capdance: capdance {
            compatible = "zmk,behavior-tap-dance";
            label = "CAPDANCE";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&sk LSHFT>, <&kp CAPS>;
        };

        // Hold sends Shift; tapping delegates to capdance for sticky Shift or Caps Lock.
        shift_caps: shift_caps {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            label = "SHIFT_STICKY_OR_CAPS_LOCK";
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&capdance>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // Holding Lower and Raise together activates Adjust.
        tri_layer {
            if-layers = <2 3>;
            then-layer = <4>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // QWERTY base layer with home-row mods and an ESC tap / NAV hold key.
        qwerty {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // |ESCNAV|  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ENT  |
            //                    | WIN | ALT |SPC/L|   |ENT/R| CTRL | ALT |
            bindings = <
                &kp TAB             &kp Q         &kp W         &kp E        &kp R        &kp T   &kp Y   &kp U        &kp I        &kp O         &kp P            &kp BSPC
                &nrgbt NAVCLR ESC   &hml LSHFT A  &hml LCTRL S  &hml LGUI D  &hml LALT F  &kp G   &kp H   &hmr RALT J  &hmr RGUI K  &hmr RCTRL L  &hmr RSHFT SEMI  &kp SQT
                &shift_caps LSHFT 0 &kp Z         &kp X         &kp C        &kp V        &kp B   &kp N   &kp M        &kp COMMA    &kp DOT       &kp FSLH         &kp RET
                &kp LGUI  &kp LALT  &lrgbt LWRCLR SPACE  &rrgbt RSECLR RET  &kp RCTRL  &kp RALT
            >;
        };

        // Colemak base layer.
        colemak {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  F  |  P  |  G  |   |  J  |  L   |  U  |  Y  |  ;  | BKSP |
            // |ESCNAV|  A  |  R  |  S  |  T  |  D  |   |  H  |  N   |  E  |  I  |  O  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  K  |  M   |  ,  |  .  |  /  | ENT  |
            //                    | GUI | ALT |SPC/L|   |ENT/R| CTRL | ALT |
            bindings = <
                &kp TAB             &kp Q         &kp W         &kp F        &kp P        &kp G   &kp J   &kp L        &kp U        &kp Y         &kp SEMI       &kp BSPC
                &nrgbt NAVCLR ESC   &hml LSHFT A  &hml LCTRL R  &hml LGUI S  &hml LALT T  &kp D   &kp H   &hmr RALT N  &hmr RGUI E  &hmr RCTRL I  &hmr RSHFT O   &kp SQT
                &shift_caps LSHFT 0 &kp Z         &kp X         &kp C        &kp V        &kp B   &kp K   &kp M        &kp COMMA    &kp DOT       &kp FSLH       &kp RET
                &kp LGUI  &kp LALT  &lrgbt LWRCLR SPACE  &rrgbt RSECLR RET  &kp RCTRL  &kp RALT
            >;
        };

        // Lower: symbols, F-keys, Delete, and media controls; the right inner thumb accesses Raise/Adjust.
        lower {
            // -----------------------------------------------------------------------------------------
            // |  ~  |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | DEL  |
            // | DEL | F1  | F2  | F3  | F4  | F5  |   | F6  |  _  |  +  |  {  |  }  | PIPE |
            // |     | F7  | F8  | F9  | F10 | F11 |   | F12 |     |     |     |     |      |
            //                   |     |     |     |   |ENT/R|NEXT |PLAY |
            bindings = <
                &kp TILDE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp DEL
                &kp DEL    &kp F1    &kp F2  &kp F3    &kp F4    &kp F5     &kp F6     &kp UNDER  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE
                &trans     &kp F7    &kp F8  &kp F9    &kp F10   &kp F11    &kp F12    &trans     &trans     &trans    &trans    &trans
                &trans  &trans  &trans  &rrgbt ADJCLR RET  &kp C_NEXT  &kp C_PP
            >;
        };

        // Raise: numbers, symbols and punctuation.
        raise {
            // -----------------------------------------------------------------------------------------
            // | GRV |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | DEL |     |     |     |     | PGUP|   | HOME|  -  |  =  |  [  |  ]  |  \   |
            // |     |     |     |     |     | PGDN|   | END |     |     |     |     |      |
            //                   |     |     |SPC/L|   |     |     |     |
            bindings = <
                &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5     &kp N6    &kp N7     &kp N8     &kp N9    &kp N0    &kp BSPC
                &kp DEL    &trans  &trans  &trans  &trans  &kp PG_UP  &kp HOME  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH
                &trans     &trans  &trans  &trans  &trans  &kp PG_DN  &kp END   &trans     &trans     &trans    &trans    &trans
                &trans  &trans  &lrgbt ADJCLR SPACE  &trans  &trans  &trans
            >;
        };

        // Adjust is active while Lower and Raise are both held.
        adjust {
            // -----------------------------------------------------------------------------------------
            // |      | BOOT|     |     |     |     |   |     |     |     |     |     | DEL  |
            // | BTCLR| BT 0| BT 1| BT 2| BT 3|     |   |     |QWERT|CLMAK|     |     |      |
            // |      |     |     |     |     |     |   |     | INS |PRSCR| SLCK|PAUSE|      |
            //                    |     |     |     |   |     |     |     |
            bindings = <
                &trans      &bootloader   &trans        &trans        &trans        &trans  &trans  &trans   &trans     &trans    &trans           &kp DEL
                &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans  &trans  &to 0    &to 1      &trans    &trans           &trans
                &trans      &trans        &trans        &trans        &trans        &trans  &trans  &kp INS  &kp PSCRN  &kp SLCK  &kp PAUSE_BREAK  &trans
                &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        // NAV: Delete, volume/mute, and arrow keys; holding ESCNAV selects it and shows the NAV color.
        nav {
            // -----------------------------------------------------------------------------------------
            // |     |     |     |     |     |     |   |     |     |     |     |     | DEL |
            // |     |     |VOL- |VOL+ |MUTE |     |   |LEFT |DOWN | UP  |RIGHT|     |     |
            // |     |     |     |     |     |     |   |     |     |     |     |     |     |
            //                   |     |     |     |   |     |     |     |
            bindings = <
                &trans  &trans  &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp DEL
                &trans  &trans  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE    &trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT   &trans    &trans
                &trans  &trans  &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans        &trans        &trans  &trans
            >;
        };

        // RGB test palette: hues sweep across columns; each row uses different saturation/brightness.
        rgb {
            bindings = <
                &rgb_ug RGB_COLOR_HSB(0,80,60)  &rgb_ug RGB_COLOR_HSB(20,80,60)  &rgb_ug RGB_COLOR_HSB(40,80,60)     &rgb_ug RGB_COLOR_HSB(60,80,60)   &rgb_ug RGB_COLOR_HSB(80,80,60)   &rgb_ug RGB_COLOR_HSB(100,80,60)    &rgb_ug RGB_COLOR_HSB(120,80,60)  &rgb_ug RGB_COLOR_HSB(140,80,60)  &rgb_ug RGB_COLOR_HSB(160,80,60)  &rgb_ug RGB_COLOR_HSB(180,80,60)  &rgb_ug RGB_COLOR_HSB(200,80,60)  &rgb_ug RGB_COLOR_HSB(220,80,60)
                &rgb_ug RGB_COLOR_HSB(0,60,40)  &rgb_ug RGB_COLOR_HSB(20,60,40)  &rgb_ug RGB_COLOR_HSB(40,60,40)     &rgb_ug RGB_COLOR_HSB(60,60,40)   &rgb_ug RGB_COLOR_HSB(80,60,40)   &rgb_ug RGB_COLOR_HSB(100,60,40)    &rgb_ug RGB_COLOR_HSB(120,60,40)  &rgb_ug RGB_COLOR_HSB(140,60,40)  &rgb_ug RGB_COLOR_HSB(160,60,40)  &rgb_ug RGB_COLOR_HSB(180,60,40)  &rgb_ug RGB_COLOR_HSB(200,60,40)  &rgb_ug RGB_COLOR_HSB(220,60,40)
                &rgb_ug RGB_COLOR_HSB(0,80,30)  &rgb_ug RGB_COLOR_HSB(20,80,30)  &rgb_ug RGB_COLOR_HSB(40,80,30)     &rgb_ug RGB_COLOR_HSB(60,80,30)   &rgb_ug RGB_COLOR_HSB(80,80,30)   &rgb_ug RGB_COLOR_HSB(100,80,30)    &rgb_ug RGB_COLOR_HSB(120,80,30)  &rgb_ug RGB_COLOR_HSB(140,80,30)  &rgb_ug RGB_COLOR_HSB(160,80,30)  &rgb_ug RGB_COLOR_HSB(180,80,30)  &rgb_ug RGB_COLOR_HSB(200,80,30)  &rgb_ug RGB_COLOR_HSB(220,80,30)
                &trans                          &trans                           &trans                              &trans                            &trans                            &trans
            >;
        };

        // Autoshift layer: letters use the autoshift behavior; other keys pass through.
        autoshift {
            bindings = <
                &trans  &as Q   &as W     &as E   &as R   &as T     &as Y   &as U   &as I   &as O   &as P   &trans
                &trans  &as A   &as S     &as D   &as F   &as G     &as H   &as J   &as K   &as L   &trans  &trans
                &trans  &as Z   &as X     &as C   &as V   &as B     &as N   &as M   &trans  &trans  &trans  &trans
                &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
